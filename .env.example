# ==============================================================================
# Sakura Configuration Template
# Copy this file to '.env' in the root directory and update the settings.
# ==============================================================================

# ─────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────
# SQLAlchemy Database URL connection string.
# Format: mysql+aiomysql://<username>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/sakura_db

# ─────────────────────────────────────────────────────────
# LLM Providers & Key Configuration
# ─────────────────────────────────────────────────────────
# LLM Provider selection. Options: deepseek / qwen / doubao / openai / custom
LLM_PROVIDER=deepseek

# API keys for specific AI providers (leave empty if not using)
PROVIDER_DEEPSEEK_KEY=
PROVIDER_QWEN_KEY=
PROVIDER_DOUBAO_KEY=
PROVIDER_OPENAI_KEY=
PROVIDER_CUSTOM_KEY=
PROVIDER_CUSTOM_BASE=

# Summary LLM Configuration (fallback for backend summarization routines)
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ─────────────────────────────────────────────────────────
# TTS Configuration (GPT-SoVITS)
# ─────────────────────────────────────────────────────────
TTS_ENABLED=true
TTS_ENGINE=gpt_sovits

# GPT-SoVITS API server URL
GPT_SOVITS_BASE_URL=http://127.0.0.1:9880

# GPT-SoVITS reference audio settings.
# GPT_SOVITS_REF_AUDIO_PATH MUST be an absolute file path on the machine running GPT-SoVITS
GPT_SOVITS_REF_AUDIO_PATH=
GPT_SOVITS_PROMPT_TEXT=这个身体似乎不会老去，但我想见的人，却都离去了。
GPT_SOVITS_PROMPT_LANG=zh
GPT_SOVITS_TEXT_LANG=zh

# ─────────────────────────────────────────────────────────
# Vision Models (Image-to-Text / Scene Recognition)
# ─────────────────────────────────────────────────────────
IMAGE_TO_TEXT_PROVIDER=deepseek
IMAGE_TO_TEXT_MODEL=minicpm-v
IMAGE_TO_TEXT_API_KEY=
IMAGE_TO_TEXT_API_BASE=https://api.deepseek.com/v1

SCENE_RECOGNITION_PROVIDER=deepseek
SCENE_RECOGNITION_MODEL=minicpm-v
SCENE_RECOGNITION_API_KEY=
SCENE_RECOGNITION_API_BASE=https://api.deepseek.com/v1

# ─────────────────────────────────────────────────────────
# API Authentication Token
# ─────────────────────────────────────────────────────────
# Static API Token used by the frontend interface to authorize backend endpoints.
# This should match 'VITE_API_TOKEN' in frontend config.
API_TOKEN=sakura-private-token-a7f3k9z2m1p8q4w6

# ─────────────────────────────────────────────────────────
# RAG Vector Retrieval (FAISS & Embeddings)
# ─────────────────────────────────────────────────────────
# Embedding mode: local or api
EMBEDDING_MODE=local

# Local Embedding settings
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DIMENSION=512

# API Embedding settings (used if EMBEDDING_MODE=api)
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
